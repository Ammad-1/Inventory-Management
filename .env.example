# Copy this file to .env and fill in the values. .env is gitignored.
# The server reads it at startup via `import 'dotenv/config'`.

# ---------------------------------------------------------------------------
# Server binding
# ---------------------------------------------------------------------------
# Loopback only by default. Change HOST only when deploying behind a proxy.
PORT=5000
HOST=127.0.0.1

# Origin of the web UI. Used for the post-OAuth redirect back into the app.
APP_URL=http://localhost:3000

# Browser origins allowed to call this API (comma separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Xero OAuth 2.0
# ---------------------------------------------------------------------------
# Client ID / Secret come from https://developer.xero.com/app/manage
# You can either set them here or save them in the app's Xero Sync screen.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must match a Redirect URI registered on your Xero app exactly.
# Xero allows plain http ONLY for the `localhost` hostname - http://127.0.0.1
# is rejected, so keep `localhost` here even though the server binds to
# 127.0.0.1 (the browser resolves localhost to it).
XERO_REDIRECT_URI=http://localhost:5000/api/xero/callback

# ---------------------------------------------------------------------------
# Xero webhooks
# ---------------------------------------------------------------------------
# Paste the Webhook Key shown on your Xero app's Webhooks tab.
# The /api/xero/webhook endpoint fails closed (HTTP 503) while this is unset,
# so signatures can never be checked against a default value.
# Xero requires the delivery URL to be HTTPS on port 443, so local testing
# needs a tunnel - see the Cloudflare/ngrok instructions in the README.
XERO_WEBHOOK_KEY=

# Optional scope override. Xero deprecated the broad `accounting.transactions`
# scope in favour of granular ones; apps created from March 2026 only accept
# the granular set. Leave unset to use the default granular scopes.
XERO_SCOPES=
